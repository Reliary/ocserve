# refine — systemd user unit (SRE.md §5 / MEMORY.md sidecar boundary).
# Install: cp deploy/refine.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now refine
[Unit]
Description=refine (opencode-compatible server, freeze 1.18.31)
After=network.target
# StartLimit* belong HERE ([Unit]) — as [Service] options systemd ignores
# them (observed: bind-fail restart loop reached 1582 without tripping).
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=%h/src/refine/target/release/refine serve --port 4912
WorkingDirectory=%h/src/refine
Environment=REFINE_DATA_DIR=%h/.local/share/refine
Environment=RUST_LOG=refine=info
# MIMALLOC_* env removed 2026-10-04: no allocator is linked (dead config).
# Re-add with real allocator wiring if/when profiling justifies it.
Restart=on-failure
RestartSec=5
# Combined cgroup budget: refine ≤300MB + node plugin sidecar ≤160MB +
# streaming-generation burst margin. Measured 2026-10: cgroup steady
# 341-347MB (refine + sidecar); a first-run long generation tripped a 480M
# cap → oom-kill → clean systemd restart (fail-fast worked; cap too tight
# for allocator page retention during delta bursts). Children share this
# cgroup, so MemoryMax must cover the sidecar or systemd OOM-kills plugins.
# 2026-10-02: raised 600M→750M — W5 battery (MCP reconnect ×2 + auth
# PUT/DELETE reloads + search + sidecar + embedding model) hit the 600M
# cap exactly (systemd: kernel OOM kill, peak 600M; steady post-restart
# is ~412MB cgroup). Provenance: journal 19:20:09 oom-kill.
MemoryMax=750M
MemorySwapMax=0
ProtectSystem=strict
ReadWritePaths=%h/.local/share/refine %h/.local/share/opencode %h/.cache/opencode %h/.config/opencode %h/src/reliary8
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=default.target
