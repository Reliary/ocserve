# Loopback alias: the opencode web UI (hosted app.opencode.ai and the README
# quickstart) dials http://localhost:4096; the live unit serves on 4912
# (oc-remote + tailnet forward). This forwarder makes the documented port work
# locally without touching the primary listener.
[Unit]
Description=ocserve web-UI loopback forward (4096 -> 4912)
# Same lesson as the tailnet forwarder (rule 55): PartOf/Requires propagate STOP
# but not start, and install.sh restarts ocserve on every deploy, so this unit
# died silently on 2026-10-23 and stayed dead for two days while port 4096
# refused connections. Wants+After, retry forever, never propagate stop.
StartLimitIntervalSec=0
After=network.target ocserve.service
Wants=ocserve.service

[Service]
Type=simple
# wait for ocserve to accept connections (30 x 1s, upstream pattern)
ExecStartPre=/usr/bin/bash -c 'for _ in {1..30}; do timeout 1 bash -c "</dev/tcp/127.0.0.1/4912" && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/socat TCP-LISTEN:4096,bind=127.0.0.1,fork,reuseaddr TCP:127.0.0.1:4912
Restart=always
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=default.target
