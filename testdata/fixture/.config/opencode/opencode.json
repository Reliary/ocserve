{
  "$schema": "https://opencode.ai/config.json",
  "model": "stub/stub-1",
  "provider": {
    "stub": {
      "name": "Parity Stub",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://127.0.0.1:9/v1", "apiKey": "parity-bench-key" },
      "models": {
        "stub-1": {
          "name": "Stub One",
          "limit": { "context": 200000, "output": 8192 }
