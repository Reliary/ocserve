# Upstream arm: the exact freeze binary (opencode 1.18.31), staged from
# the brew Cellar by run.sh/preflight into vendor/opencode.
# Max GLIBC needed by the freeze binary = 2.17 → bookworm (2.36) is safe
# (measured with objdump -T before this file was written).
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git procps \
    && rm -rf /var/lib/apt/lists/*
COPY vendor/opencode /usr/local/bin/opencode
RUN chmod +x /usr/local/bin/opencode \
    && opencode --version \
    && echo "upstream arm ok"
ENV HOME=/root
WORKDIR /root
EXPOSE 4921
# 0.0.0.0: inside a container a 127.0.0.1 bind is unreachable from the
# port mapping (the live systemd unit uses 127.0.0.1 — deliberate divergence)
ENTRYPOINT ["opencode", "serve", "--port", "4921", "--hostname", "0.0.0.0"]
