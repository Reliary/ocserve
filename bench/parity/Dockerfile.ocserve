# syntax=docker/dockerfile:1.7
# ocserve arm: built INSIDE the container against bookworm glibc.
# The host-built target/release/ocserve needs GLIBC_2.39 (measured via
# objdump -T on the CachyOS host, glibc 2.43) and would refuse to run on
# bookworm (2.36) — multi-stage is mandatory, not a style choice.
# NOTE: RUN type=bind mounts are read-only in BuildKit (mkdir of the
# /src/target cache mountpoint failed on it) — hence COPY, not bind.
FROM rust:1-bookworm AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . /src
RUN --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo build --release -p ocserve-cli \
    && mkdir -p /out \
    && cp /src/target/release/ocserve /out/ocserve

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ocserve /usr/local/bin/ocserve
RUN ocserve --version || true
ENV HOME=/root
WORKDIR /root
EXPOSE 4922
ENTRYPOINT ["ocserve", "serve", "--port", "4922", "--hostname", "0.0.0.0", "--data-dir", "/data"]
